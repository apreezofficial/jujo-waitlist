# Public address of the deployed page (canonical links, sitemap, share image)
NEXT_PUBLIC_SITE_URL=https://growth.getjujo.com

# Where sign-ups are sent. Each one is POSTed as JSON: { email, source, createdAt }
# Use a Google Apps Script / Zapier / Make / Slack webhook, or your own endpoint.
# Without it, sign-ups are only printed to the Vercel function logs.
WAITLIST_WEBHOOK_URL=

# Admin page (/admin) password
ADMIN_PASSWORD=

# Voieform / Proforms submissions shown on /admin
VOIEFORM_ACCESS_KEY=
VOIEFORM_FORM_KEY=

# Bulk email from /admin through Resend (https://resend.com/api-keys)
# RESEND_FROM must use a domain verified in Resend, e.g. "Jujo <hello@getjujo.com>"
RESEND_API_KEY=
RESEND_FROM=
# Optional: where replies go, e.g. support@getjujo.com
RESEND_REPLY_TO=
